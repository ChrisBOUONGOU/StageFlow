<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StageFlow.Views.Controls"
    x:Class="StageFlow.Views.LiveOutputWindow"
    Title="StageFlow Live Output"
    Background="Black"
    SystemDecorations="None"
    CanResize="False"
    ShowInTaskbar="False"
    ShowActivated="False">

	<controls:LiveOutputPanel
        x:Name="LiveOutputPanel"
        DataContext="{Binding}"/>

</Window>