<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="StageFlow.Views.Controls.MediaLibraryPanel">

	<Border
        Background="{DynamicResource AppBackgroundBrush}"
        Padding="12">

		<Grid RowDefinitions="Auto,Auto,*,Auto">

			<!-- HEADER -->

			<Grid
                ColumnDefinitions="*,Auto"
                Margin="0,0,0,10">

				<TextBlock
                    Text="MEDIA LIBRARY"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="{DynamicResource AppTextBrush}"
                    VerticalAlignment="Center"/>

				<Button
                    Grid.Column="1"
                    Content="+ Import"
                    Command="{Binding ImportMediaCommand}"/>

			</Grid>

			<!-- SEARCH -->

			<TextBox
                Grid.Row="1"
                Text="{Binding Filter}"
                Watermark="Search media..."
                Margin="0,0,0,10"/>

			<!-- MEDIA -->

			<ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

				<ItemsControl
                    ItemsSource="{Binding FilteredAssets}">

					<ItemsControl.ItemsPanel>

						<ItemsPanelTemplate>

							<WrapPanel
                                Orientation="Horizontal"/>

						</ItemsPanelTemplate>

					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>

						<DataTemplate>

							<Button
                                Command="{Binding
                                    $parent[UserControl]
                                    .DataContext
                                    .SelectAssetCommand}"
                                CommandParameter="{Binding}"
                                PointerPressed="AssetPointerPressed"
                                Padding="0"
                                Margin="4"
                                Background="Transparent"
                                BorderThickness="0">

								<Border
                                    Width="125"
                                    Height="125"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8">

									<Grid
                                        RowDefinitions="*,Auto">

										<!-- PREVIEW -->

										<Border
                                            Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                            CornerRadius="4">

											<Grid>

												<!-- IMAGE -->

												<Image
                                                    Source="{Binding AbsolutePath}"
                                                    Stretch="Uniform"
                                                    IsVisible="{Binding Type,
                                                        Converter={StaticResource ImageAssetConverter}}"/>

												<!-- FILE ICON -->

												<TextBlock
                                                    Text="{Binding TypeIcon}"
                                                    FontSize="30"
                                                    Foreground="{DynamicResource AppIconBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

											</Grid>

										</Border>

										<!-- NAME -->

										<TextBlock
                                            Grid.Row="1"
                                            Text="{Binding Name}"
                                            FontSize="11"
                                            Foreground="{DynamicResource AppTextBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Margin="0,6,0,0"/>

									</Grid>

								</Border>

							</Button>

						</DataTemplate>

					</ItemsControl.ItemTemplate>

				</ItemsControl>

			</ScrollViewer>

			<!-- SELECTED MEDIA -->

			<Border
                Grid.Row="3"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,0"
                CornerRadius="6"
                IsVisible="{Binding HasSelectedAsset}">

				<Grid
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto,Auto">

					<TextBlock
                        Text="{Binding SelectedAssetName}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AppTextBrush}"
                        TextTrimming="CharacterEllipsis"/>

					<TextBlock
                        Grid.Row="1"
                        Text="{Binding SelectedAssetType}"
                        FontSize="11"
                        Foreground="{DynamicResource AppSecondaryTextBrush}"
                        Opacity="0.65"/>

					<TextBlock
                        Grid.Row="2"
                        Text="{Binding SelectedAssetSize}"
                        FontSize="11"
                        Foreground="{DynamicResource AppSecondaryTextBrush}"
                        Opacity="0.65"/>

					<StackPanel
                        Grid.Column="1"
                        Grid.RowSpan="3"
                        Orientation="Horizontal"
                        Spacing="5">

						<Button
                            Content="Insert"
                            Command="{Binding InsertSelectedCommand}"/>

						<Button
                            Content="Delete"
                            Command="{Binding DeleteSelectedCommand}"/>

					</StackPanel>

				</Grid>

			</Border>

		</Grid>

	</Border>

</UserControl>

