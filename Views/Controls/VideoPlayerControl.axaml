<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
    x:Class="StageFlow.Views.Controls.VideoPlayerControl">

	<Border
        Background="#080A0F">

		<Grid RowDefinitions="*,Auto">

			<!-- VIDEO -->
			<Border
                Grid.Row="0"
                Background="Black">

				<vlc:VideoView
                    x:Name="VideoView"/>
			</Border>

			<!-- CONTROLS -->
			<Border
                Grid.Row="1"
                Background="#11151D"
                Padding="10">

				<Grid
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="Auto,*,Auto">

					<!-- PLAY -->
					<Button
                        x:Name="PlayPauseButton"
                        Content="▶"
                        Width="45"
                        Height="35"
                        Click="PlayPause_Click"/>

					<!-- TIMELINE -->
					<Slider
                        x:Name="TimelineSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        PointerPressed="Timeline_PointerPressed"
                        PointerReleased="Timeline_PointerReleased"/>

					<!-- TIME -->
					<TextBlock
                        x:Name="TimeText"
                        Grid.Column="2"
                        Text="00:00 / 00:00"
                        VerticalAlignment="Center"/>

					<!-- SECOND ROW -->
					<StackPanel
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="0,10,0,0">

						<Button
                            Content="⏮"
                            Click="Restart_Click"/>

						<TextBlock
                            Text="Volume"
                            VerticalAlignment="Center"/>

						<Slider
                            x:Name="VolumeSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            Width="120"
                            ValueChanged="Volume_ValueChanged"/>

						<CheckBox
                            x:Name="LoopCheckBox"
                            Content="Loop"
                            VerticalAlignment="Center"/>

						<TextBlock
                            x:Name="VideoNameText"
                            VerticalAlignment="Center"
                            Opacity="0.7"/>

					</StackPanel>

				</Grid>

			</Border>

		</Grid>

	</Border>
</UserControl>