<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="StageFlow.Views.Controls.ThemePanel">

	<Border
        Background="{DynamicResource AppBackgroundBrush}"
        Padding="12">

		<Grid
            RowDefinitions="Auto,*,Auto">

			<!-- ================================================= -->
			<!-- HEADER -->
			<!-- ================================================= -->

			<TextBlock
                Text="THEMES"
                FontSize="15"
                FontWeight="Bold"
                Margin="0,0,0,10"
                Foreground="{DynamicResource AppTextBrush}"/>


			<!-- ================================================= -->
			<!-- THEME LIST -->
			<!-- ================================================= -->

			<ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">

				<ItemsControl
                    ItemsSource="{Binding Themes}">

					<ItemsControl.ItemTemplate>

						<DataTemplate>

							<Button
                                Command="{Binding $parent[UserControl].DataContext.SelectThemeCommand}"
                                CommandParameter="{Binding}"
                                Padding="0"
                                Margin="0,0,0,8"
                                Background="Transparent"
                                BorderThickness="0">

								<Border
                                    Width="250"
                                    Height="85"
                                    CornerRadius="8"
                                    Background="{Binding BackgroundColor}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    Padding="12">

									<Grid
                                        ColumnDefinitions="*,Auto">

										<StackPanel>

											<TextBlock
                                                Text="{Binding Name}"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="{Binding PrimaryColor}"/>

											<TextBlock
                                                Text="{Binding FontFamily}"
                                                FontSize="11"
                                                Foreground="{Binding SecondaryColor}"
                                                Margin="0,4,0,0"/>

										</StackPanel>

										<Border
                                            Grid.Column="1"
                                            Width="24"
                                            Height="24"
                                            CornerRadius="12"
                                            Background="{Binding AccentColor}"
                                            VerticalAlignment="Center"/>

									</Grid>

								</Border>

							</Button>

						</DataTemplate>

					</ItemsControl.ItemTemplate>

				</ItemsControl>

			</ScrollViewer>


			<!-- ================================================= -->
			<!-- SELECTED THEME -->
			<!-- ================================================= -->

			<Border
                Grid.Row="2"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,10,0,0">

				<StackPanel>

					<TextBlock
                        Text="{Binding SelectedThemeName}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AppTextBrush}"/>

					<TextBlock
                        Text="{Binding SelectedThemeFont}"
                        FontSize="11"
                        Foreground="{DynamicResource AppSecondaryTextBrush}"
                        Opacity="0.8"/>

					<TextBlock
                        Text="{Binding SelectedThemeBackground}"
                        FontSize="11"
                        Foreground="{DynamicResource AppSecondaryTextBrush}"
                        Opacity="0.8"/>

					<Button
                        Content="APPLY THEME"
                         Command="{Binding ApplyThemeCommand}"
                    
                        Margin="0,8,0,0"/>

				</StackPanel>

			</Border>

		</Grid>

	</Border>

</UserControl>